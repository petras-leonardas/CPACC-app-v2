{
  "name": "cpacc-app-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "git config --global url.\"https://github.com/\".insteadOf ssh://git@github.com/ && git config --global url.\"https://github.com/\".insteadOf git@github.com:",
    "dev": "vite",
    "build": "tsc -b && tsx scripts/generate-sitemap.ts && tsx scripts/generate-og-images.tsx && vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "generate:css-vars": "node scripts/generateCSSVariables.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "sync-questions": "node scripts/sync-from-sheets.cjs",
    "generate-sitemap": "tsx scripts/generate-sitemap.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:storybook": "npm run build-storybook && npx wrangler pages deploy storybook-static --project-name=cpacc-design-system --commit-dirty=true"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.33.1",
    "@leo-designs/components": "https://github.com/petras-leonardas/DS-leo-designs-the-world.git#3c2a9610671043b37e266e9b24ddcd949b229803",
    "@marsidev/react-turnstile": "^1.5.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-cookie-consent": "^10.0.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.10.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "googleapis": "^167.0.0",
    "@chromatic-com/storybook": "^5.0.0",
    "@cloudflare/workers-types": "^4.20251205.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-themes": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.22",
    "clsx": "^2.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.11",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "satori": "^0.26.0",
    "storybook": "^10.1.11",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21",
    "vitest": "^4.0.17",
    "wrangler": "^4.53.0"
  }
}
